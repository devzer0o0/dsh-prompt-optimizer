{
  "name": "@feiyu999/dsh-prompt-optimizer",
  "version": "0.1.2",
  "description": "Turns the words you type into the composer into a well-formed prompt before the model ever sees them, using a cheap side call on the same route.",
  "type": "module",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devzer0o0/dsh-prompt-optimizer.git"
  },
  "homepage": "https://awesome-dsh-plugin.com/p/devzer0o0/dsh-prompt-optimizer/",
  "bugs": {
    "url": "https://github.com/devzer0o0/dsh-prompt-optimizer/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.png",
    "assets/",
    "docs/",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis-plugin",
    "prompt",
    "prompt-optimizer"
  ],
  "license": "MIT"
}
